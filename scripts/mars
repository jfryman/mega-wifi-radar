#!/bin/sh
# Run a command inside the mega_wifi_radar 32X build image (macOS + Linux, Podman or Docker).
#   scripts/mars make -C mars/spike
#   scripts/mars --image       # just make sure the image exists (prints its name)
#   scripts/mars --name        # print the image name without pulling or building
# The image tag is a hash of everything that defines it, so editing mars/Dockerfile
# always triggers a rebuild. The Genesis image (scripts/md) is separate and unaffected.
# A missing image is first pulled from $MARS_REGISTRY (CI publishes every hash there);
# set MARS_REGISTRY= (empty) to always build locally. MARS_BUILD_FLAGS adds build options.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CTR=${CTR:-$(command -v podman || command -v docker || true)}
[ -n "$CTR" ] || { echo "mars: need podman or docker on PATH" >&2; exit 1; }

if command -v sha256sum >/dev/null 2>&1; then SHA="sha256sum"; else SHA="shasum -a 256"; fi
HASH=$(cd "$ROOT" && find mars/Dockerfile -type f | LC_ALL=C sort \
       | xargs cat | $SHA | cut -c1-12)
IMAGE="mwradar-mars:$HASH"
REGISTRY=${MARS_REGISTRY-ghcr.io/jfryman/mega-wifi-radar-mars}
[ "${1:-}" = "--name" ] && { echo "$IMAGE"; exit 0; }

if ! "$CTR" image inspect "$IMAGE" >/dev/null 2>&1; then
    if [ -n "$REGISTRY" ] && "$CTR" pull "$REGISTRY:$HASH" >&2 2>/dev/null; then
        "$CTR" tag "$REGISTRY:$HASH" "$IMAGE"
    else
        echo "mars: building $IMAGE (first build compiles two gccs; ~30-60 min)" >&2
        # shellcheck disable=SC2086
        "$CTR" build ${MARS_BUILD_FLAGS:-} -t "$IMAGE" -f "$ROOT/mars/Dockerfile" "$ROOT/mars" >&2
    fi
fi
[ "${1:-}" = "--image" ] && { echo "$IMAGE"; exit 0; }

# Keep output files owned by the host user.
case "$(basename "$CTR")" in
    podman) USEROPT="--userns=keep-id" ;;
    *)      USEROPT="--user $(id -u):$(id -g)" ;;
esac

TTY=""; [ -t 0 ] && [ -t 1 ] && TTY="-t"
# shellcheck disable=SC2086
exec "$CTR" run --rm -i $TTY $USEROPT -e HOME=/tmp \
    -v "$ROOT:/work" -w /work "$IMAGE" "$@"
