#!/bin/sh
# Capture the manual's screenshots from the emulator build in headless MAME (committed: CI has no MAME).
#   scripts/print-shots         # Genesis: print/shots.txt -> print/shots/ (needs `make sim`)
#   scripts/print-shots 32x     # 32X: print/shots-32x.txt -> print/shots-32x/ (needs `make mars-sim`, bios/32x/)
set -eu
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
if [ "${1:-}" = 32x ]; then
    LIST=print/shots-32x.txt DIR=print/shots-32x ROM=out/mars/emu/mwradar.32x SIM=scripts/mars-sim SNAP=out/snap/32x
else
    LIST=print/shots.txt DIR=print/shots ROM=out/sim.bin SIM=scripts/sim SNAP=out/snap/genesis
fi
[ -f "$ROM" ] || { echo "print-shots: build $ROM first (make sim / make mars-sim)" >&2; exit 1; }
mkdir -p "$DIR"
grep -vE '^\s*(#|$)' "$LIST" | while IFS='|' read -r name at presses; do
    name=$(echo "$name" | xargs); at=$(echo "$at" | xargs); presses=$(echo "$presses" | xargs)
    SIM_PRESS="$presses" "$SIM" "$ROM" "$at" >/dev/null
    cp "$SNAP/0000.png" "$DIR/$name.png"
    echo "print-shots: $DIR/$name.png"
done
