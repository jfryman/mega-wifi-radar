#!/bin/sh
# Build and run the relay container (macOS + Linux, Podman or Docker).
#   scripts/relay build        # build mwradar-relay:<git describe> from this checkout (runs go vet + tests)
#   scripts/relay run          # run in the foreground on port ${RELAY_PORT:-8080}
#   scripts/relay start|stop|logs   # detached container named mwradar-relay
#   scripts/relay advertise    # (re-)register the mDNS advertisement only, e.g. after a reboot
# Extra args after run/start go to the relay, e.g. scripts/relay run -min-interval 2s
#
# Dev relays are built from the checkout and tagged with its version, so the relay you run is the
# code you have: mwradar-relay:v0.2.0-3-gabc1234, plus a hash of relay/ when the tree is dirty, so
# edits get a fresh build. run/start build the tag if it's missing. To run a published release
# instead: RELAY_IMAGE=ghcr.io/jfryman/mega-wifi-radar-relay:0.2.0 scripts/relay start (pulled if needed).
#
# Discovery (lode/net/discovery.md): a bridged or VM container never sees LAN multicast, so the
# container runs with -mdns=false and the HOST advertises _mwradar._tcp for it: dns-sd -P on
# macOS, avahi-publish on Linux. Set RELAY_MDNS=0 to skip that.
#
# Configuration (relay/main.go serverEnv): RELAY_* and MQTT_* variables in this shell are passed to the
# container (MQTT_BROKER_HOST, MQTT_BROKER_PORT, MQTT_USERNAME, MQTT_PASSWORD, MQTT_TOPIC, ...). With the dev
# broker up (scripts/mqtt start) and no MQTT_BROKER_HOST set, the relay joins its network and uses it.
set -eu

ROOT=$(cd "$(dirname "$0")/.." && pwd)
CTR=${CTR:-$(command -v podman || command -v docker || true)}
[ -n "$CTR" ] || { echo "relay: need podman or docker on PATH" >&2; exit 1; }
VERSION=$(git -C "$ROOT" describe --tags --always --dirty 2>/dev/null || echo dev)
case "$VERSION" in
    *-dirty) SUM=$(cd "$ROOT" && find relay -type f | LC_ALL=C sort | xargs cat | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-8)
             VERSION="$VERSION.$SUM" ;;
esac
IMAGE=${RELAY_IMAGE:-mwradar-relay:$VERSION}
NAME=mwradar-relay
PORT=${RELAY_PORT:-8080}
PIDFILE="$ROOT/.tools/relay-mdns.pid"

unadvertise() {
    if [ -f "$PIDFILE" ]; then
        kill "$(cat "$PIDFILE")" 2>/dev/null || true
        rm -f "$PIDFILE"
    fi
}

# Register "MegaWiFi Radar" _mwradar._tcp on $PORT with the host's mDNS daemon (background).
advertise() {
    [ "${RELAY_MDNS:-1}" = 0 ] && return 0
    unadvertise
    mkdir -p "$ROOT/.tools"
    # TXT as the built-in responder sends it, from the contract (src/arframe.h: AR_VER, AR_FRAME_PATH)
    ver=$(awk '$1 == "#define" && $2 == "AR_VER" {print $3}' "$ROOT/src/arframe.h")
    path=$(awk -F'"' '/#define AR_FRAME_PATH/ {print $2}' "$ROOT/src/arframe.h")
    if command -v dns-sd >/dev/null 2>&1; then          # macOS: proxy record for this Mac's LAN IP
        iface=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}')
        ip=$(ipconfig getifaddr "${iface:-en0}" 2>/dev/null || true)
        [ -n "$ip" ] || { echo "relay: no LAN IP found; mDNS advertisement skipped" >&2; return 0; }
        nohup dns-sd -P "MegaWiFi Radar" _mwradar._tcp local "$PORT" mwradar-relay.local "$ip" \
            "v=$ver" "path=$path" >/dev/null 2>&1 &
        echo $! > "$PIDFILE"
        echo "relay: advertising _mwradar._tcp at $ip:$PORT (dns-sd, pid $(cat "$PIDFILE"))"
    elif command -v avahi-publish >/dev/null 2>&1; then  # Linux: avahi uses the host's addresses
        nohup avahi-publish -s "MegaWiFi Radar" _mwradar._tcp "$PORT" "v=$ver" "path=$path" >/dev/null 2>&1 &
        echo $! > "$PIDFILE"
        echo "relay: advertising _mwradar._tcp on port $PORT (avahi-publish, pid $(cat "$PIDFILE"))"
    else
        echo "relay: no dns-sd or avahi-publish; cartridges must use a typed relay URL" >&2
    fi
}

# Container args for configuration: the dev broker's network, and the relay's env variables.
config_args() {
    if "$CTR" network inspect mwradar >/dev/null 2>&1; then printf '%s\n' --network mwradar; fi
    if [ -z "${MQTT_BROKER_HOST:-}" ] && "$CTR" container inspect -f '{{.State.Running}}' mwradar-mqtt 2>/dev/null | grep -q true; then
        printf '%s\n' -e MQTT_BROKER_HOST=mwradar-mqtt
        echo "relay: using the dev MQTT broker (mwradar-mqtt)" >&2
    fi
    # Names only (-e VAR), so values such as MQTT_PASSWORD never show in ps. RELAY_PORT/IMAGE/MDNS are this script's.
    env | grep -E '^(RELAY|MQTT)_[A-Z_]*=' | cut -d= -f1 | grep -v -x -e RELAY_PORT -e RELAY_IMAGE -e RELAY_MDNS \
        | while read -r v; do printf '%s\n' -e "$v"; done
    return 0
}

need_image() {
    "$CTR" image inspect "$IMAGE" >/dev/null 2>&1 && return 0
    if [ -n "${RELAY_IMAGE:-}" ]; then "$CTR" pull "$IMAGE"; else "$0" build; fi
}

cmd=${1:-run}; [ $# -gt 0 ] && shift
case "$cmd" in
    build) [ -z "${RELAY_IMAGE:-}" ] || { echo "relay: RELAY_IMAGE is set; build makes local images only" >&2; exit 2; }
           exec "$CTR" build -t "$IMAGE" --build-arg VERSION="$VERSION" "$ROOT/relay" ;;
    run)   need_image
           advertise
           trap unadvertise EXIT INT TERM
           # shellcheck disable=SC2046 # one arg per line, none with spaces
           IFS='
'
           "$CTR" run --rm -it --init -p "$PORT:8080" $(config_args) "$IMAGE" -listen :8080 -mdns=false "$@" ;;
    start) need_image
           "$CTR" rm -f "$NAME" >/dev/null 2>&1 || true
           IFS='
'
           # shellcheck disable=SC2046 # one arg per line, none with spaces
           "$CTR" run -d --name "$NAME" --restart unless-stopped -p "$PORT:8080" $(config_args) \
               "$IMAGE" -listen :8080 -mdns=false "$@"
           unset IFS
           advertise
           echo "relay: $IMAGE" ;;
    stop)  unadvertise; "$CTR" rm -f "$NAME" ;;
    advertise) advertise ;;
    logs)  exec "$CTR" logs -f "$NAME" ;;
    *)     echo "usage: scripts/relay build|run|start|stop|advertise|logs [relay args]" >&2; exit 2 ;;
esac
