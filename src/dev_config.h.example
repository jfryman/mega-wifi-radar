/* Dev-only overrides. Copy to src/dev_config.h (git-ignored) and edit.
 * With no SSID defined, the ROM joins whatever AP config the module has saved. */
#define DEV_WIFI_SSID "my-network"
#define DEV_WIFI_PASS "my-password"
/* Relay base URL (plain HTTP). Use the FQDN: lwIP ignores the DHCP search domain. */
#define DEV_RELAY_URL "http://my-relay-host.my.lan:8080"
